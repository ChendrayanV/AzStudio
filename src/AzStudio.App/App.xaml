<Application x:Class="AzStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AzStudio.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentDarkBrush" Color="#005A9E" />
            <SolidColorBrush x:Key="BorderBrush2" Color="#D0D5DA" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#E4E6E9" />
            <SolidColorBrush x:Key="ConnectedBrush" Color="#2E7D32" />
            <SolidColorBrush x:Key="DisconnectedBrush" Color="#C0392B" />

            <FontFamily x:Key="AppFontFamily">./Assets/Fonts/#Montserrat, Segoe UI</FontFamily>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style TargetType="Button">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#B9BEC3" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#6B6F76" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Padding" Value="4" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="4" />
            </Style>

            <Style TargetType="ListView">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,8,0,2" />
                <Setter Property="Foreground" Value="#3B3F45" />
            </Style>

            <!-- Label preceding an inline field (e.g. "Namespace:  [textbox]"). Fixed, right-aligned
                 width so every field on a panel starts at the same x-position regardless of label length. -->
            <Style x:Key="InlineFieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="MinWidth" Value="112" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!-- Left-hand "Azure Services" navigation entry (Storage / Service Bus). -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small filled dot showing MainViewModel.IsConnected: red while disconnected, green once connected. -->
            <Style x:Key="ConnectionStatusDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Drag handle between two side-by-side list/detail panes (Containers|Blobs, Secrets|Versions, etc). -->
            <Style x:Key="PanelSplitter" TargetType="GridSplitter">
                <Setter Property="Width" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{StaticResource BorderBrush2}" />
                <Setter Property="Cursor" Value="SizeWE" />
                <Setter Property="ShowsPreview" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
