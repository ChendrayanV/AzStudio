<Window x:Class="AzStudio.App.Views.ConnectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection" Height="560" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Connection name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" />

                <TextBlock Text="Authenticate using" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ServicePrincipalRadio" Content="Service Principal" GroupName="Auth"
                                 Margin="0,4,20,4" Checked="AuthType_Checked" />
                    <RadioButton x:Name="InteractiveRadio" Content="Sign in as user (Azure AD)" GroupName="Auth"
                                 Margin="0,4,0,4" Checked="AuthType_Checked" />
                </StackPanel>

                <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TenantIdBox" />

                <TextBlock x:Name="ClientIdLabel" Text="Client (App) ID" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ClientIdBox" />

                <StackPanel x:Name="SecretPanel">
                    <TextBlock Text="Client secret" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="ClientSecretBox" />
                    <TextBlock x:Name="SecretHintText" Foreground="#6B6F76" FontSize="11" Margin="0,3,0,0"
                               Text="Leave blank to keep the existing saved secret." Visibility="Collapsed" />
                </StackPanel>

                <TextBlock Text="Default storage account name (optional — can also be typed on the Blob Storage tab)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="StorageAccountBox" />

                <TextBlock Text="Default Service Bus namespace (optional — can also be typed on the Service Bus tab), e.g. my-namespace" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ServiceBusNamespaceBox" />

                <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Save" Click="Save_Click" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
