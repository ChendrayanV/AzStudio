<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AzStudio.Avalonia.Views.SecretValueWindow"
        Title="Secret Value" Height="320" Width="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontFamily}"
        Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap">
            <Run Text="Secret: " FontWeight="SemiBold" /><Run Name="NameRun" />
            <LineBreak />
            <Run Text="Version: " FontWeight="SemiBold" /><Run Name="VersionRun" />
        </TextBlock>

        <TextBlock Grid.Row="1" Text="This value is sensitive — avoid sharing your screen while it's revealed."
                   Foreground="#6B6F76" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,10" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Name="ToggleButton" Content="Show" Click="Toggle_Click" />
            <Button Content="Copy to Clipboard" Classes="secondary" Click="Copy_Click" />
        </StackPanel>

        <TextBox Name="ValueBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True"
                 FontFamily="Consolas" Background="#F7F7F7" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Click="Close_Click" IsDefault="True" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
