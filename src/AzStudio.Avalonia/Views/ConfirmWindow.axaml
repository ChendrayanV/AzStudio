<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AzStudio.Avalonia.Views.ConfirmWindow"
        Title="Confirm" Height="170" Width="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontFamily}"
        Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Name="MessageText" Grid.Row="0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="No" Classes="secondary" Click="No_Click" IsCancel="True" />
            <Button Content="Yes" Click="Yes_Click" IsDefault="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
