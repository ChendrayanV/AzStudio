<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows-only PE resource (Explorer/taskbar icon) — a no-op on other OSes' builds.
         Separate from MainWindow.axaml's Icon="...", which is the in-app title-bar/Alt-Tab
         icon and needs a Skia-decodable format (png), not .ico. -->
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to the 11.x line, not the newer 12.x default `dotnet new avalonia.app` picked:
      12.1.2's bundled Roslyn source generator (which is what emits InitializeComponent()
      for each Window/UserControl) requires a newer C# compiler than this .NET 8 SDK ships
      (warning CS9057 confirms the mismatch) and silently produces nothing instead of
      erroring clearly. 11.3.22 is the current stable line and builds cleanly here.
    -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzStudio.Core\AzStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
